{
    "name": "nativeui/native-wheel-datepicker",
    "description": "A wheel date picker EDGE component for NativePHP Mobile v4 (SwiftUI + Jetpack Compose).",
    "type": "nativephp-plugin",
    "license": "MIT",
    "keywords": [
        "nativephp",
        "nativephp-plugin",
        "edge",
        "wheel-picker",
        "date-picker"
    ],
    "require": {
        "php": "^8.2",
        "nativephp/mobile": "^4.0",
        "nativephp/mobile-ui": "^0.3"
    },
    "autoload": {
        "psr-4": {
            "NativeUI\\WheelDatePicker\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "NativeUI\\WheelDatePicker\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "pestphp/pest": "^2.0"
    },
    "scripts": {
        "test": "pest"
    },
    "extra": {
        "laravel": {
            "providers": [
                "NativeUI\\WheelDatePicker\\WheelDatePickerServiceProvider"
            ]
        },
        "nativephp": {
            "manifest": "nativephp.json"
        },
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
